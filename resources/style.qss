/* ═══════════════════════════════════════════════════════════════
   ПНОС — шаблон темы оформления.
   Цвета заданы токенами (символ-собака + имя + символ-собака) и подставляются из theme.py.
   Не хардкодьте цвета здесь — добавляйте токен в палитры LIGHT/DARK.
   ═══════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI", sans-serif;
}

/* Базовый цвет текста: не полагаемся на системную палитру Windows —
   при тёмной системной теме обычные QLabel иначе становятся белыми
   на светлых панелях (текст «пропадает»). */
QLabel {
    color: @text_primary@;
}

QMainWindow, QWidget#root {
    background-color: @bg_app@;
}

/* ─── Заголовки ────────────────────────────────────────────────── */
QLabel#app_header {
    font-size: 16px;
    font-weight: bold;
    color: @text_primary@;
    padding: 4px 0;
}

QLabel#app_header_accent {
    color: @accent@;
}

QLabel#app_title {
    font-size: 22px;
    font-weight: 800;
    color: @text_primary@;
    margin-bottom: 2px;
}

QLabel#card_description {
    font-size: 13px;
    color: @text_secondary@;
    line-height: 1.4;
}

QLabel#section_label {
    color: @text_muted@;
    font-weight: bold;
    font-size: 11px;
}

/* ─── Карточка шага конвейера ──────────────────────────────────── */
QFrame#step_card {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 10px;
}

QFrame#step_card:hover {
    border-color: @accent@;
}

QLabel#step_badge {
    background-color: @border@;
    color: @text_muted@;
    border-radius: 15px;
    font-size: 13px;
    font-weight: 700;
}

QLabel#step_badge[status="run"] {
    background-color: @accent@;
    color: #ffffff;
}

QLabel#step_badge[status="done"] {
    background-color: @success@;
    color: #ffffff;
}

QLabel#step_badge[status="error"] {
    background-color: @error@;
    color: #ffffff;
}

QLabel#step_badge[status="wait"] {
    background-color: @warn@;
    color: #ffffff;
}

QLabel#step_title {
    font-size: 13px;
    font-weight: 700;
    color: @text_primary@;
}

QLabel#step_summary {
    font-size: 11px;
    color: @text_muted@;
}

QPushButton#step_action {
    background-color: @accent@;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#step_action:hover { background-color: @accent_hover@; }
QPushButton#step_action:pressed { background-color: @accent_press@; }
QPushButton#step_action:disabled {
    background-color: @border@;
    color: @text_faint@;
}

QPushButton#step_stop {
    background-color: transparent;
    color: @error@;
    border: 1px solid @error@;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#step_stop:hover {
    background-color: @error@;
    color: #ffffff;
}

QProgressBar#step_progress {
    border: none;
    background-color: @border@;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#step_progress::chunk {
    background-color: @accent@;
    border-radius: 2px;
}

/* ─── Панель настроек ──────────────────────────────────────────── */
#settings_panel {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 10px;
    padding: 14px;
}

#settings_panel QLabel {
    font-size: 12px;
    color: @text_muted@;
    font-weight: 500;
}

QLineEdit {
    background-color: @bg_input@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 7px 10px;
    color: @text_primary@;
    font-size: 12px;
    selection-background-color: @accent@;
}

QLineEdit:focus {
    border-color: @accent@;
    background-color: @bg_input_focus@;
}

QLineEdit:disabled {
    background-color: @bg_app@;
    color: @text_faint@;
}

/* Поле ввода ВНУТРИ таблицы (редактор ячейки). У обычного QLineEdit отступы
   7px сверху и снизу плюс рамки — в высоту строки таблицы это не влезает, и
   текст при вводе обрезается по высоте. Редактору нужны свои отступы. */
QAbstractItemView QLineEdit,
QTableWidget QLineEdit,
QTableView QLineEdit {
    padding: 0px 4px;
    border-radius: 3px;
    border: 1px solid @accent@;
}

QTextEdit, QPlainTextEdit {
    background-color: @bg_input@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px;
    color: @text_primary@;
    font-size: 12px;
    selection-background-color: @accent@;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @accent@;
    background-color: @bg_input_focus@;
}

/* ─── Комбобокс и поле даты (форма ручного контроля) ───────────── */
QComboBox, QDateEdit {
    background-color: @bg_input@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 7px 10px;
    color: @text_primary@;
    font-size: 12px;
    min-height: 18px;
}

QComboBox:focus, QDateEdit:focus,
QComboBox:hover, QDateEdit:hover {
    border-color: @accent@;
    background-color: @bg_input_focus@;
}

QComboBox:disabled, QDateEdit:disabled {
    background-color: @bg_app@;
    color: @text_faint@;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow, QDateEdit::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @text_muted@;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 6px;
    color: @text_primary@;
    selection-background-color: @accent@;
    selection-color: #ffffff;
    outline: none;
}

QCalendarWidget QWidget { alternate-background-color: @bg_panel_alt@; }
QCalendarWidget QAbstractItemView:enabled {
    background-color: @bg_panel@;
    color: @text_primary@;
    selection-background-color: @accent@;
    selection-color: #ffffff;
}
QCalendarWidget QToolButton {
    color: @text_primary@;
    background-color: transparent;
}
QCalendarWidget QMenu { background-color: @bg_panel@; color: @text_primary@; }

/* Поле обязательное и пустое — жёлтая подсветка внимания */
QComboBox[attention="true"], QLineEdit[attention="true"], QTextEdit[attention="true"] {
    border: 1px solid @warn_border@;
    background-color: @warn_bg@;
}

/* Поле с ошибкой валидации — красная рамка */
QComboBox[invalid="true"], QLineEdit[invalid="true"],
QTextEdit[invalid="true"], QDateEdit[invalid="true"] {
    border: 1px solid @error@;
}

/* ─── Чекбоксы ─────────────────────────────────────────────────── */
QCheckBox {
    color: @text_primary@;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid @border_strong@;
    border-radius: 4px;
    background-color: @bg_input@;
}

QCheckBox::indicator:checked {
    background-color: @accent@;
    border-color: @accent@;
    image: none;
}

/* ─── Группбоксы (настройки) ───────────────────────────────────── */
QGroupBox {
    font-weight: bold;
    color: @text_primary@;
    border: 1px solid @border_strong@;
    border-radius: 8px;
    margin-top: 15px;
    padding: 15px;
    background-color: @bg_panel@;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QLabel#hint {
    color: @text_muted@;
    font-size: 11px;
}

QLabel#field_note {
    color: @text_muted@;
    font-size: 11px;
}

/* Состояние записи модуля «Ремонт». Пока не нажата «Применить выбранное»,
   согласованные изменения живут только на экране — это должно быть видно,
   иначе пункт уходит в дальнейшие этапы со старыми замерами. */
QLabel#apply_state {
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 6px;
    color: @text_secondary@;
}

QLabel#apply_state[state="wait"] {
    color: @warn@;
    background-color: @warn_bg@;
    border: 1px solid @warn_border@;
}

QLabel#apply_state[state="done"] {
    color: @success@;
}

QFrame#h_divider {
    background-color: @border@;
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ─── Чипы-сводка (Обзор) ──────────────────────────────────────── */
QFrame#stat_chip {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 8px;
}

QLabel#chip_value {
    font-size: 17px;
    font-weight: 800;
    color: @text_primary@;
}

QLabel#chip_value_good { font-size: 17px; font-weight: 800; color: @success@; }
QLabel#chip_value_bad { font-size: 17px; font-weight: 800; color: @error@; }
QLabel#chip_value_warn { font-size: 17px; font-weight: 800; color: @warn@; }

QLabel#chip_caption {
    font-size: 10px;
    color: @text_muted@;
    font-weight: 600;
}

/* ─── Кнопки общие ─────────────────────────────────────────────── */
QPushButton {
    background-color: @bg_content@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 14px;
    color: @text_secondary@;
    font-size: 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: @border@;
}

QPushButton:pressed {
    background-color: @border_strong@;
}

QPushButton:disabled {
    background-color: @bg_panel_alt@;
    color: @text_faint@;
    border-color: @border@;
}

QPushButton#browse_btn {
    padding: 7px 10px;
    min-width: 32px;
    font-size: 14px;
}

/* ─── Основные кнопки ──────────────────────────────────────────── */
QPushButton#card_button {
    background-color: @accent@;
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 9px 20px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#card_button:hover {
    background-color: @accent_hover@;
}

QPushButton#card_button:pressed {
    background-color: @accent_press@;
}

QPushButton#card_button:disabled {
    background: @border@;
    color: @text_faint@;
}

/* ─── Второстепенная кнопка (контур) ───────────────────────────── */
QPushButton#ghost_button {
    background-color: transparent;
    border: 1px solid @border_strong@;
    border-radius: 8px;
    padding: 9px 18px;
    color: @text_secondary@;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#ghost_button:hover {
    background-color: @bg_panel_alt@;
    border-color: @accent@;
    color: @accent@;
}

/* ─── Кнопка «Стоп» ────────────────────────────────────────────── */
QPushButton#stop_button {
    background-color: @error@;
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 9px 15px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#stop_button:hover {
    background-color: @error_hover@;
}

QPushButton#stop_button:pressed {
    background-color: @error_strong@;
}

QPushButton#stop_button:disabled {
    background: @bg_content@;
    color: @text_faint@;
}

/* ─── Синяя кнопка (проверить обновления) ──────────────────────── */
QPushButton#blue_button {
    background-color: @info_blue@;
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    padding: 11px 20px;
    border-radius: 8px;
    border: none;
}
QPushButton#blue_button:hover { background-color: @info_blue_hover@; }
QPushButton#blue_button:disabled { background-color: @text_faint@; }

/* ─── Зелёная кнопка (установить обновление) ───────────────────── */
QPushButton#green_button {
    background-color: @success_strong@;
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    padding: 11px 20px;
    border-radius: 8px;
    border: none;
}
QPushButton#green_button:hover { background-color: @success_hover@; }
QPushButton#green_button:disabled { background-color: @text_faint@; }

/* ─── Лог ──────────────────────────────────────────────────────── */
QTextEdit#log_panel {
    background-color: @dark_panel@;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    color: @dark_panel_text@;
}

/* ─── Прогресс-бары ────────────────────────────────────────────── */
QProgressBar {
    border: none;
    background-color: @border@;
    border-radius: 4px;
    min-height: 8px;
}

QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 4px;
}

QProgressBar#global_progress {
    background-color: @dark_panel_border@;
}
QProgressBar#global_progress::chunk {
    background-color: @teal@;
}

/* ─── Скролл-бар ───────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @scrollbar@;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: @accent@;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @scrollbar@;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: @accent@; }

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    height: 0;
    width: 0;
}

/* ─── Модальное окно и карточки статистики ─────────────────────── */
QDialog#report_dialog {
    background-color: @bg_panel_alt@;
    border-radius: 12px;
}

QDialog#report_dialog QLabel#report_title {
    font-size: 18px;
    font-weight: 800;
    color: @text_primary@;
}

QFrame#stat_box {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 10px;
}

QLabel#report_stat {
    font-size: 12px;
    color: @text_muted@;
    font-weight: 600;
}

QLabel#report_stat_good {
    font-size: 16px;
    color: @success@;
    font-weight: 800;
}

QLabel#report_stat_bad {
    font-size: 16px;
    color: @error@;
    font-weight: 800;
}

/* ─── Таблицы ──────────────────────────────────────────────────── */
QTableWidget {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 8px;
    gridline-color: @border@;
    font-size: 12px;
    color: @text_primary@;
    alternate-background-color: @row_alt@;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: @selection@;
    color: @text_primary@;
}

QHeaderView::section {
    background-color: @bg_panel_alt@;
    color: @text_muted@;
    font-weight: bold;
    font-size: 12px;
    padding: 6px;
    border: none;
    border-bottom: 2px solid @border@;
    border-right: 1px solid @border@;
}

QHeaderView::section:last {
    border-right: none;
}

/* ─── Сайдбар ──────────────────────────────────────────────────── */
QFrame#sidebar {
    background-color: @bg_sidebar@;
    border-right: 1px solid @bg_sidebar_logo@;
}

QFrame#logo_frame {
    background-color: @bg_sidebar_logo@;
}

QLabel#sidebar_title {
    color: #ffffff;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#sidebar_subtitle {
    color: @teal@;
    font-size: 11px;
    font-weight: 800;
}

QPushButton#nav_button {
    background-color: transparent;
    border: none;
    border-radius: 0;
    border-left: 4px solid transparent;
    color: @sidebar_text@;
    text-align: left;
    padding: 11px 16px 11px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#nav_button:hover {
    background-color: @bg_sidebar_hover@;
    color: @sidebar_text_hover@;
}

QPushButton#nav_button:checked {
    background-color: @teal@;
    color: #0f172a;
    border-left: 4px solid @teal_dark@;
    font-weight: 700;
}

QPushButton#nav_button:disabled {
    color: @sidebar_muted@;
}

QLabel#global_caption {
    color: @sidebar_text@;
    font-weight: bold;
    font-size: 11px;
}

QLabel#session_timer {
    color: @teal@;
    font-weight: 700;
    font-size: 12px;
}

/* ─── Сегмент-переключатели (скорость / тема) ──────────────────── */
QPushButton#segment {
    background-color: @bg_content@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 8px 18px;
    color: @text_muted@;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#segment:hover { background-color: @border@; }
QPushButton#segment:checked {
    background-color: @accent@;
    border-color: @accent@;
    color: #ffffff;
}

/* ─── Контент ──────────────────────────────────────────────────── */
QFrame#content_frame {
    background-color: @bg_content@;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QPushButton#link_button {
    background-color: transparent;
    border: none;
    color: @accent@;
    font-weight: 600;
    text-align: right;
    padding: 0;
}

QPushButton#link_button:hover {
    color: @accent_press@;
    text-decoration: underline;
}

/* ─── Журнал (строгая лента) ───────────────────────────────────── */
QListWidget#activity_feed {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px;
    font-size: 11px;
    color: @text_secondary@;
    outline: none;
}

QListWidget#activity_feed::item {
    padding: 3px 6px;
    border: none;
}

QListWidget#activity_feed::item:selected {
    background-color: @bg_panel_alt@;
    color: @text_primary@;
    border-radius: 4px;
}

/* ─── Список пунктов (форма ручного контроля / обзор) ──────────── */
QListWidget#point_list {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 4px;
    font-size: 13px;
    color: @text_primary@;
    outline: none;
}

QListWidget#point_list::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 1px 2px;
}

QListWidget#point_list::item:selected {
    background-color: @accent@;
    color: #ffffff;
}

QListWidget#point_list::item:hover:!selected {
    background-color: @bg_panel_alt@;
}

/* ─── Карточка формы (ручной контроль) ─────────────────────────── */
QFrame#form_card {
    background-color: @bg_panel@;
    border: 1px solid @border@;
    border-radius: 12px;
}

QLabel#form_field_label {
    color: @text_primary@;
    font-size: 12px;
    font-weight: 700;
}

QLabel#form_field_req {
    color: @error@;
    font-size: 12px;
    font-weight: 700;
}

QLabel#form_title {
    font-size: 16px;
    font-weight: 800;
    color: @text_primary@;
}


/* ═══ Всплывающее уведомление (тост) ═══ */
QLabel#toast {
    background-color: @bg_panel@;
    color: @text_primary@;
    border: 1px solid @success_strong@;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}
